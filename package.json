{
	"name": "bone-animation",
	"description": "Desktop-oriented cutout animation editor for PixiJS sprite-sheet export.",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "bun --hot --port 3000 index.html",
		"build": "bun run typecheck && bun build ./index.html --outdir dist --minify",
		"check": "bun run lint && bun run test && bun run build",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:fix": "eslint . --ext .ts,.tsx --fix",
		"test": "bun test src tests/unit",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"idb": "^8.0.2",
		"pixi.js": "^8.14.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@playwright/test": "^1.55.0",
		"@types/bun": "^1.3.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"eslint": "^9.35.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.42.0"
	}
}
